datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../cmpclient"
}

model CmpUser {
  id    BigInt    @id @default(autoincrement())
  email String    @unique
  posts CmpPost[]

  @@map("cmp_users")
}

model CmpPost {
  id       BigInt  @id @default(autoincrement())
  title    String
  author   CmpUser @relation(fields: [authorId], references: [id])
  authorId BigInt

  @@map("cmp_posts")
}
